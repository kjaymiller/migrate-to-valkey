# To use age encryption, keep the [providers.age] section and configure your key.
# If you prefer no encryption locally, remove it and add:
# [providers.plaintext]
# type = "plaintext"

[providers.age]
type = "age"
recipients = ["your_age_public_key_here"]

[secrets]
# When using `fnox import` or `fnox set`, secrets will automatically be added/updated below.
TARGET_CONNECTION_STRING = { provider = "age", value = "encrypted_value_here" }
SOURCE_CONNECTION_STRING = { provider = "age", value = "encrypted_value_here" }
