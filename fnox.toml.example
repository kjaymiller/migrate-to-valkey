# fnox.toml
# This file configures the connection strings for the migration tools.
# NOTE: The actual `fnox.toml` path is gitignored to keep your secrets safe locally.
# We default to plaintext for ease of use, but you can configure age/SOPS encryption if desired.

[providers.plaintext]
type = "plaintext"

[secrets]
TARGET_CONNECTION_STRING = { provider = "plaintext", value = "valkey://..." }
SOURCE_CONNECTION_STRING = { provider = "plaintext", value = "valkey://..." }
